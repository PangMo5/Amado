        "PRODUCT_NAME": "AmadoWidget",
        "PROVISIONING_PROFILE_SPECIFIER": "$(AMADO_WIDGET_PROVISIONING_PROFILE)",
        "SDKROOT": "iphoneos",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "YES",
