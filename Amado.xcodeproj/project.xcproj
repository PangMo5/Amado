    }, {
      "name": "AmadoTests",
      "id": "FC99D042D6C39AD50CCA6188",
      "product": "Products/AmadoTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "Amado",
      "dependencies": [
        "Amado",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "AmadoKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "CasePaths",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "ComposableArchitecture",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "ConcurrencyExtras",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "Dependencies",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "DependenciesMacros",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "Sharing",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "TOML",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "GENERATE_INFOPLIST_FILE": "YES",
        "LD_RUNPATH_SEARCH_PATHS": "$(inherited) @loader_path/../Frameworks @executable_path/../Frameworks",
        "MACOSX_DEPLOYMENT_TARGET": "15.0",
        "MARKETING_VERSION": "$(AMADO_IOS_VERSION)",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.PangMo5.Amado.Tests",
        "PRODUCT_NAME": "AmadoTests",
        "SDKROOT": "macosx",
        "SUPPORTED_PLATFORMS": "macosx",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Amado.app/Contents/MacOS/Amado",
        "TEST_TARGET_NAME": "Amado",
      },
    },
  ],
}
